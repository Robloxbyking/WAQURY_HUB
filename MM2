local function copyToClipboard(text)
    if setclipboard then
        setclipboard(text)
        return true
    elseif syn and syn.clipboard then
        syn.clipboard(text)
        return true
    elseif toclipboard then
        toclipboard(text)
        return true
    elseif game:GetService("GuiService") then
        game:GetService("GuiService"):OpenBrowser(text)
        return false
    else
        return false
    end
end

