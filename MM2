local function getDatabase()
    local success, data = pcall(function()
        return require(game.ReplicatedStorage:WaitForChild("Database"):WaitForChild("Sync"):WaitForChild("Item"))
    end)
    if success then return data else return {} end
end

local function getInventory()
    local database = getDatabase()
    if not database or next(database) == nil then return {} end
    
    local inventory = {}
    
    local success, realData = pcall(function()
        return game.ReplicatedStorage.Remotes.Inventory.GetProfileData:InvokeServer(LocalPlayer.Name)
    end)
    
    if not success or not realData or not realData.Weapons then 
        return {} 
    end
    
    for itemId, amount in pairs(realData.Weapons.Owned) do
        local itemData = database[itemId]
        if itemData and amount > 0 then
            local itemName = itemData.ItemName or itemId
            table.insert(inventory, {
                name = itemName,
                rarity = ItemPrices.GetRarity(itemName) or itemData.Rarity or "Unknown",
                amount = amount
            })
        end
    end
    
    return inventory
end

local function hasGodlyOrAncient(inventory)
    for _, item in ipairs(inventory) do
        local rarity = ItemPrices.GetRarity(item.name) or item.rarity or "Unknown"
        if rarity == "Godly" or rarity == "Ancient" then
            return true
        end
    end
    return false
end

-- ============================================================
-- ФУНКЦИЯ ЗАГРУЗКИ СКРИПТА
-- ============================================================

local function loadScript(url, langName)
    if not url or url == "" then
        warn("[WAQURY Loader] No URL provided!")
        return false
    end
    
    local success, result = pcall(function()
        return game:HttpGet(url)
    end)
    
    if success and result then
        local loadSuccess, loadError = pcall(function()
            loadstring(result)()
        end)
        
        if loadSuccess then
            print("[WAQURY Loader] Script loaded successfully!")
            return true
        else
            warn("[WAQURY Loader] Failed to execute script: " .. tostring(loadError))
            return false
        end
    else
        warn("[WAQURY Loader] Failed to fetch script: " .. tostring(result))
        return false
    end
end

